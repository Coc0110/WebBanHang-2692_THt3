@model WebBanHang_2692.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">

<style>
    /* Chèn CSS của template vào đây */
    .product-image {
        max-height: 600px;
        max-width: 600px;
        object-fit: cover;
    }

    .thumbnail {
        width: 80px;
        height: 80px;
        object-fit: cover;
        cursor: pointer;
        opacity: 0.6;
        transition: opacity 0.3s ease;
    }

        .thumbnail:hover, .thumbnail.active {
            opacity: 1;
        }
</style>

<div class="container mt-5 mb-5">
    <div class="row">
        <div class="col-md-6 mb-4">
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded mb-3 product-image w-100 shadow-sm" id="mainImage">

            <div class="d-flex justify-content-start gap-2 overflow-auto">
                <img src="@Model.ImageUrl" alt="Thumbnail Main" class="thumbnail rounded active shadow-sm" onclick="changeImage(event, this.src)">

                @if (Model.Images != null && Model.Images.Any())
                {
                    foreach (var img in Model.Images)
                    {
                        <img src="@img.Url" alt="Thumbnail" class="thumbnail rounded shadow-sm" onclick="changeImage(event, this.src)">
                    }
                }
            </div>
        </div>

        <div class="col-md-6">
            <h2 class="mb-3 fw-bold">@Model.Name</h2>
            <p class="text-muted mb-4">Danh mục: <span class="badge bg-secondary">@(Model.Category?.Name ?? "Chưa phân loại")</span></p>

            <div class="mb-3">
                <span class="h3 me-2 text-danger fw-bold">@Model.Price.ToString("#,##0") đ</span>
                <span class="text-muted"><s>@((Model.Price * 1.1m).ToString("#,##0")) đ</s></span>
            </div>

            <div class="mb-3">
                <i class="bi bi-star-fill text-warning"></i>
                <i class="bi bi-star-fill text-warning"></i>
                <i class="bi bi-star-fill text-warning"></i>
                <i class="bi bi-star-fill text-warning"></i>
                <i class="bi bi-star-fill text-warning"></i>
                <span class="ms-2">5.0</span>
            </div>

            <p class="mb-4">@Model.Description</p>

            @if (!User.IsInRole(WebBanHang_2692.Models.SD.Role_Admin))
            {
                <div class="mb-4">
                    <h5>Phân loại:</h5>
                    <div class="btn-group" role="group" aria-label="Color selection">
                        <input type="radio" class="btn-check" name="color" id="black" autocomplete="off" checked>
                        <label class="btn btn-outline-dark" for="black">Thường</label>
                        <input type="radio" class="btn-check" name="color" id="silver" autocomplete="off">
                        <label class="btn btn-outline-danger" for="silver">Shiny</label>
                    </div>
                </div>

                <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post" class="mb-3">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="mb-4">
                        <label for="quantity" class="form-label fw-bold">Số lượng:</label>
                        <input type="number" name="quantity" class="form-control shadow-sm" id="quantity" value="1" min="1" style="width: 100px;">
                    </div>

                    <button type="submit" class="btn btn-danger btn-lg me-2 px-5 shadow-sm">
                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                    </button>
                </form>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg mb-3 shadow-sm">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>

        </div>
    </div>
</div>

<script>
    function changeImage(event, src) {
        document.getElementById('mainImage').src = src;
        document.querySelectorAll('.thumbnail').forEach(thumb => thumb.classList.remove('active'));
        event.target.classList.add('active');
    }
</script>