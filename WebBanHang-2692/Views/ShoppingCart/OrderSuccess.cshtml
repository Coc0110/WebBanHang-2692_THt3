@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5 mb-5 text-center">
    <div class="py-5">
        <i class="bi bi-check-circle text-success" style="font-size: 5rem;"></i>
        <h2 class="fw-bold mt-4 mb-3">Đặt hàng thành công!</h2>
        <p class="text-muted fs-5">Mã đơn hàng của bạn là: <strong>#@Model</strong></p>
        <p>Cảm ơn bạn đã mua sắm tại MyStore. Đơn hàng sẽ sớm được giao đến bạn.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-danger mt-4 rounded-pill px-4">
            Trở về trang chủ
        </a>
    </div>
</div>