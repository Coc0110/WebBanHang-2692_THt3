@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="fw-bold mb-4 text-danger"><i class="bi bi-person-vcard me-2"></i>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-12">
        <!-- Khối 1: Thông tin cá nhân -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold text-dark"><i class="bi bi-info-circle text-danger me-2"></i>Thông tin cơ bản</h5>
            </div>
            <div class="card-body p-4">
                <form id="profile-form" method="post" asp-page-handler="UpdateProfile">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="Username" class="form-control bg-light" placeholder="Tên đăng nhập" disabled />
                                <label asp-for="Username" class="form-label text-muted">Tên đăng nhập (Email)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="ProfileInput.FullName" class="form-control" placeholder="Họ và tên" />
                                <label asp-for="ProfileInput.FullName" class="form-label">Họ và tên</label>
                                <span asp-validation-for="ProfileInput.FullName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="ProfileInput.PhoneNumber" class="form-control" placeholder="Số điện thoại" />
                                <label asp-for="ProfileInput.PhoneNumber" class="form-label">Số điện thoại</label>
                                <span asp-validation-for="ProfileInput.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-4">
                                <input asp-for="ProfileInput.Address" class="form-control" placeholder="Địa chỉ giao hàng" />
                                <label asp-for="ProfileInput.Address" class="form-label">Địa chỉ giao hàng (Mặc định)</label>
                                <span asp-validation-for="ProfileInput.Address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <button id="update-profile-button" type="submit" class="btn btn-danger btn-lg px-5 rounded-pill shadow-sm fw-bold">
                        <i class="bi bi-save me-1"></i> Lưu thông tin
                    </button>
                </form>
            </div>
        </div>

        <!-- Khối 2: Đổi mật khẩu -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="fw-bold text-dark"><i class="bi bi-shield-lock text-danger me-2"></i>Đổi mật khẩu</h5>
            </div>
            <div class="card-body p-4">
                <form id="change-password-form" method="post" asp-page-handler="ChangePassword">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="PasswordInput.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Mật khẩu cũ." />
                        <label asp-for="PasswordInput.OldPassword" class="form-label">Mật khẩu hiện tại</label>
                        <span asp-validation-for="PasswordInput.OldPassword" class="text-danger"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input asp-for="PasswordInput.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu mới." />
                                <label asp-for="PasswordInput.NewPassword" class="form-label">Mật khẩu mới</label>
                                <span asp-validation-for="PasswordInput.NewPassword" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-4">
                                <input asp-for="PasswordInput.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu." />
                                <label asp-for="PasswordInput.ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                                <span asp-validation-for="PasswordInput.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-outline-danger btn-lg px-5 rounded-pill shadow-sm fw-bold">
                        <i class="bi bi-key me-1"></i> Cập nhật mật khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}