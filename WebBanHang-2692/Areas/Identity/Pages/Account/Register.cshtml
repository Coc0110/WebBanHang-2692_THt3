@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    ViewData["HideHeader"] = true; // Bật cờ ẩn Header
}

<style>
    .auth-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: #f6f5f7;
        font-family: 'Montserrat', sans-serif;
        margin: -20px -20px 0 -20px;
    }
    /* ÉP CHIỀU CAO CỐ ĐỊNH LÀ 620PX ĐỂ KHÔNG BỊ GIẬT FORM */
    .florin-container {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 14px 28px rgba(0,0,0,0.25), 0 10px 10px rgba(0,0,0,0.22);
        position: relative;
        overflow: hidden;
        width: 768px;
        max-width: 100%;
        height: 620px;
    }

        .florin-container h1 {
            font-weight: bold;
            margin: 0;
            padding-bottom: 10px;
        }

        .florin-container p {
            font-size: 14px;
            font-weight: 100;
            line-height: 20px;
            letter-spacing: 0.5px;
            margin: 20px 0 30px;
        }

    .florin-button {
        border-radius: 20px;
        border: 1px solid #FF4B2B;
        background-color: #FF4B2B;
        color: #FFFFFF;
        font-size: 12px;
        font-weight: bold;
        padding: 12px 45px;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: transform 80ms ease-in;
        margin-top: 15px;
    }

        .florin-button:active {
            transform: scale(0.95);
        }

        .florin-button.ghost {
            background-color: transparent;
            border-color: #FFFFFF;
            display: inline-block;
            line-height: 1.5;
        }

    .florin-form {
        background-color: #FFFFFF;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 0 50px;
        height: 100%;
        text-align: center;
    }

    .florin-input {
        background-color: #eee;
        border: none;
        padding: 12px 15px;
        margin: 6px 0;
        width: 100%;
        border-radius: 5px;
        font-size: 13px;
    }

    .form-container {
        position: absolute;
        top: 0;
        height: 100%;
        transition: all 0.6s ease-in-out;
    }

    .sign-up-container {
        left: 0;
        width: 50%;
        z-index: 5;
        transform: translateX(100%);
        opacity: 1;
    }

    .overlay-container {
        position: absolute;
        top: 0;
        left: 50%;
        width: 50%;
        height: 100%;
        overflow: hidden;
        z-index: 100;
        transform: translateX(-100%);
    }

    .overlay {
        background: #FF416C;
        background: linear-gradient(to right, #FF4B2B, #FF416C);
        background-size: cover;
        background-position: 0 0;
        color: #FFFFFF;
        position: relative;
        left: -100%;
        height: 100%;
        width: 200%;
        transform: translateX(50%);
    }

    .overlay-panel {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 0 40px;
        text-align: center;
        top: 0;
        height: 100%;
        width: 50%;
    }

    .overlay-left {
        transform: translateX(0);
    }
</style>

<div class="auth-wrapper">
    <div class="florin-container right-panel-active" id="container">

        <div class="form-container sign-up-container">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="florin-form">
                <h1>Đăng ký tài khoản</h1>
                <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 12px;"></div>

                <input asp-for="Input.FullName" class="florin-input" autocomplete="fullname" aria-required="true" placeholder="Họ và Tên" />
                <span asp-validation-for="Input.FullName" class="text-danger" style="font-size: 10px;"></span>

                <input asp-for="Input.Email" class="florin-input" autocomplete="username" aria-required="true" placeholder="Email" />
                <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 10px;"></span>

                <input asp-for="Input.Password" class="florin-input" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu" />
                <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 10px;"></span>

                <input asp-for="Input.ConfirmPassword" class="florin-input" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size: 10px;"></span>

                <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="florin-input">
                    <option disabled selected>- Chọn vai trò -</option>
                </select>

                <button id="registerSubmit" type="submit" class="florin-button">Đăng ký</button>

                <a href="/" style="font-size: 12px; color: #777; margin-top: 25px; text-decoration: underline;">Tiếp tục không cần tài khoản ➔</a>
            </form>
        </div>

        <div class="overlay-container">
            <div class="overlay">
                <div class="overlay-panel overlay-left">
                    <h1>Chào mừng trở lại!</h1>
                    <p>Để tiếp tục mua sắm, vui lòng đăng nhập bằng tài khoản của bạn</p>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="florin-button ghost">Đăng nhập</a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}